{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "K8sMcpServer": "Debug"
    }
  },
  "Kubernetes": {
    "UseInClusterConfig": true,
    "KubeConfigPath": null
  },
  "Prometheus": {
    "Url": "http://prometheus:9090",
    "QueryTimeoutSeconds": 30
  },
  "Loki": {
    "Url": "http://loki:3100",
    "QueryTimeoutSeconds": 30
  },
  "Mcp": {
    "ServerName": "k8s-mcp-server",
    "Version": "1.0.0",
    "RequireAuth": false
  },
  "AllowedTools": [
    "cluster_health",
    "check_disk_pressure",
    "check_oom_kills",
    "check_pod_restarts",
    "query_metrics"
  ]
}